# copy this file to .env and fill in the values for your machine.
# only variables prefixed with VITE_ are exposed to the browser bundle - and EVERYTHING
# exposed there can be read by any visitor, so never put a password, token or api secret
# in this file. server secrets belong in the root .env, which the browser never sees.

# where the Milk Nest api is listening (no trailing slash). the api must also allow this
# website's origin: PUBLIC_SITE_ORIGIN in the root .env
VITE_SERVER_URL=http://localhost:4200

# contact details shown in the contact section and the footer. leave one empty to hide it
VITE_CONTACT_PHONE=+91 00000 00000
VITE_CONTACT_EMAIL=hello@example.com
VITE_CONTACT_LOCATION=City, State, Country
